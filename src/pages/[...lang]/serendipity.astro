---
import { getCollection, render } from 'astro:content'
import { allLocales, defaultLocale } from '@/config'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

const { lang = defaultLocale } = Astro.params
const currentLang = lang as keyof typeof ui
const currentUI = ui[currentLang] ?? ui[defaultLocale]

// Get serendipities from content collection
const serendipities = await getCollection('serendipity', ({ data }) => {
  return data.lang === currentLang || data.lang === ''
})

// Sort serendipities by date in descending order
const sortedSerendipities = serendipities.sort((a, b) => {
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
})

// Render markdown content
const renderedSerendipities = await Promise.all(
  sortedSerendipities.map(async (serendipity) => {
    const { Content } = await render(serendipity)
    return {
      ...serendipity,
      Content,
    }
  }),
)

export function getStaticPaths() {
  return allLocales.map(locale => ({
    params: { lang: locale === defaultLocale ? undefined : locale },
  }))
}
---

<Layout>
  <div class="uno-decorative-line" />
  <!-- Page Title -->
  <h1 class="mb-16 text-center text-4xl font-bold tracking-tight">{currentUI.serendipity || 'Serendipity'}</h1>

  <!-- Serendipities List -->
  <div class="space-y-16">
    {renderedSerendipities.length > 0
      ? (
        renderedSerendipities.map((serendipity, index) => (
          <>
            <article data-id={serendipity.id} class="group">
              <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
                <h2 class="text-xl font-light tracking-wide">{serendipity.data.title}</h2>
                <span class="text-xs text-secondary/40">{serendipity.data.published.toLocaleDateString('zh-CN')}</span>
              </div>
              <div class="heti">
                <div id="post-content" class="overflow-hidden transition-all duration-500 ease-in-out" style="max-height: 90px;">
                  <serendipity.Content />
                </div>
                <button
                  class="mt-3 text-sm text-secondary/60 underline underline-offset-4 transition-all duration-300 hover:text-secondary hover:underline-offset-6"
                  data-id={serendipity.id}
                >
                  展开
                </button>
              </div>
            </article>
            {index < renderedSerendipities.length - 1 && (
              <hr class="border-secondary/5" />
            )}
          </>
        ))
      )
      : (
        <div class="py-32 text-center text-sm text-secondary/30">
          {currentUI.noSerendipity || '暂无偶得内容'}
        </div>
      )}
  </div>

  <script>
let openId: string | null = null
const collapsedHeight = '90px'

function checkContentHeight() {
  document.querySelectorAll('#post-content').forEach((content) => {
    const article = content.closest('article')
    if (article) {
      const button = article.querySelector('button')
      const contentHeight = content.scrollHeight

      // 如果内容高度小于等于收起高度，隐藏按钮
      if (contentHeight <= Number.parseInt(collapsedHeight)) {
        if (button) {
          button.style.display = 'none'
        }
        (content as HTMLElement).style.maxHeight = 'none'
      }
      else {
        if (button) {
          button.style.display = 'block'
        }
        (content as HTMLElement).style.maxHeight = collapsedHeight
      }
    }
  })
}

function setOpenId(id: string) {
  // 如果点击的是当前展开的文章，则收起它
  if (openId === id) {
    const openContent = document.querySelector(`article[data-id="${id}"] #post-content`)
    if (openContent) {
      (openContent as HTMLElement).style.maxHeight = collapsedHeight
    }
    const btn = document.querySelector(`article[data-id="${id}"] button`)
    if (btn) {
      btn.textContent = '展开'
    }
    openId = null
  }
  else {
    // 收起所有文章
    document.querySelectorAll('#post-content').forEach((content) => {
      (content as HTMLElement).style.maxHeight = collapsedHeight
    })
    document.querySelectorAll('button[data-id]').forEach((btn) => {
      btn.textContent = '展开'
    })

    // 展开当前点击的文章
    openId = id
    const openContent = document.querySelector(`article[data-id="${id}"] #post-content`)
    if (openContent) {
      (openContent as HTMLElement).style.maxHeight = `${openContent.scrollHeight}px`
    }
    const btn = document.querySelector(`article[data-id="${id}"] button`)
    if (btn) {
      btn.textContent = '收起'
    }
  }
}

function initSerendipity() {
  // 等待内容完全渲染后再检查高度
  setTimeout(() => {
    checkContentHeight()
  }, 100)

  // 为所有展开按钮添加点击事件
  document.querySelectorAll('button[data-id]').forEach((button) => {
    // 移除可能存在的旧事件监听器
    button.replaceWith(button.cloneNode(true))
  })

  // 重新添加事件监听器
  document.querySelectorAll('button[data-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = (button as HTMLElement).dataset.id as string
      setOpenId(id as string)
    })
  })
}

// 监听 Astro 客户端导航事件
document.addEventListener('astro:page-load', initSerendipity)

// 初始加载时执行
document.addEventListener('DOMContentLoaded', initSerendipity)

// 窗口大小变化时重新检查
window.addEventListener('resize', checkContentHeight)
</script>
</Layout>
