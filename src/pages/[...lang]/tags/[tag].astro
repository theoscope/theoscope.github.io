---
import PostList from '@/components/PostList.astro'
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'
import { ui } from '@/i18n/ui'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag: tag.name },
      props: { tag: tag.name },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const posts = await getPostsByTag(tag, currentLang)
const allTags = await getAllTags(currentLang)
const supportedLangs = await getTagSupportedLangs(tag)
---

<Layout supportedLangs={supportedLangs}>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  
  <!-- Page Title -->
  <h1 class="text-4 font-bold mb-8">{currentUI.tags}: {tag}</h1>
  
  <!-- Tag List -->
  <TagList
    tags={allTags}
    currentTag={tag}
    lang={currentLang}
  />

  <!-- Posts List -->
  <div class="mt-10.5">
    <PostList
      posts={posts}
      lang={currentLang}
    />
  </div>
  
  <!-- No Posts Message -->
  {posts.length === 0 && (
    <div class="text-center py-12 text-secondary/60">
      No posts found for this tag
    </div>
  )}
</Layout>
