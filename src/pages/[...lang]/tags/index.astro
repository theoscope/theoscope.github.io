---
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getAllTags } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const allTags = await getAllTags(currentLang)
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- Page Title -->
  <h1 
    class="mb-12 text-center text-4xl font-bold" 
    style="opacity: 0; animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;"
  >{currentUI.tags}</h1>

  <!-- Tag List -->
  <TagList
    tags={allTags}
    lang={currentLang}
  />

  <!-- Tag Description -->
  {allTags.length > 0 && (
    <div 
      class="mt-10 text-center text-sm text-secondary/60"
      style="opacity: 0; animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards; animation-delay: 0.3s;"
    >
      <p>{currentUI.tags} ({allTags.length})</p>
    </div>
  )}
</Layout>
