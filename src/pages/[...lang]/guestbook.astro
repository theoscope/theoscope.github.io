---
import { getCollection, render } from 'astro:content'
import Comment from '@/components/Comment/Index.astro'
import Cusdis from '@/components/Comment/Cusdis.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
// Get guestbook page content with different language
const allGuestbookEntries = await getCollection('about')
const guestbookEntry = allGuestbookEntries.find(entry => entry.id === `guestbook-${currentLang}`)
  ?? allGuestbookEntries.find(entry => entry.id === 'guestbook-en')
const { Content } = guestbookEntry ? await render(guestbookEntry) : { Content: null }
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- Guestbook Page Content -->
  <div class="heti">
    {Content && (
      <div class="mb-12">
        <h1
          class="mb-6 text-center text-4xl font-bold"
          style="opacity: 0; animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;"
        >{currentUI.guestbookTitle || '留言板'}</h1>
        <p
          class="mx-auto max-w-2xl text-center text-secondary/70"
          style="opacity: 0; animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards; animation-delay: 0.2s;"
        >{currentUI.guestbookDescription || '欢迎留下你的想法、建议，或者只是打个招呼！你的反馈对我来说非常重要，有助于我改进这个博客。'}</p>
      </div>
    )}

    <!-- Comment Section -->
    <div
      class="mt-16"
      style="opacity: 0; animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards; animation-delay: 0.4s;"
    >
      <Cusdis
        pageId={Astro.url.pathname}
        pageUrl={Astro.url.href}
        pageTitle={"Guestbook"}
      />
    </div>
  </div>
</Layout>
