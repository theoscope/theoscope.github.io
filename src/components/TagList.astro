---
import type { Language } from '@/i18n/config'
import { getTagPath } from '@/i18n/path'

interface Tag {
  name: string
  count: number
}

interface Props {
  tags: Tag[]
  currentTag?: string
  lang: Language
}

const { tags, currentTag = '', lang } = Astro.props
---

<div class="no-heti">
  <div class="flex flex-wrap gap-x-3 gap-y-3.2">
    {tags.map(tag => (
      <a
        href={getTagPath(tag.name, lang)}
        class:list={[
          'relative inline-flex items-center gap-2 rounded-full px-4 py-1.5 border border-secondary/25',
          'transition-all duration-300 ease-out hover:(border-primary/50 bg-primary/5 ring-0.5 ring-primary/30)',
          'hover:scale-105 hover:shadow-sm',
          currentTag === tag.name
            ? 'border-primary/50 bg-primary/5 ring-0.5 ring-primary/30 font-medium'
            : '',
        ]}
      >
        <span class="whitespace-nowrap">{tag.name}</span>
        <span class="h-6 min-w-6 inline-flex items-center justify-center rounded-full bg-secondary/10 px-1.5 text-xs font-medium">
          {tag.count}
        </span>
      </a>
    ))}
  </div>

  {tags.length === 0 && (
    <div class="py-12 text-center text-secondary/60">
      No tags found
    </div>
  )}
</div>
