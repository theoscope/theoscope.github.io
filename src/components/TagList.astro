---
import type { Language } from '@/i18n/config'
import { getTagPath } from '@/i18n/path'

interface Tag {
  name: string
  count: number
}

interface Props {
  tags: Tag[]
  currentTag?: string
  lang: Language
}

const { tags, currentTag = '', lang } = Astro.props
---

<div class="no-heti">
  <div class="flex flex-wrap gap-x-3.5 gap-y-3.5">
    {tags.map((tag, index) => (
      <a
        href={getTagPath(tag.name, lang)}
        class:list={[
          'relative inline-flex items-center gap-2 rounded-xl px-4.5 py-2 border border-border',
          'transition-all duration-400 cubic-bezier(0.165, 0.84, 0.44, 1)',
          'hover:(border-primary/40 bg-primary/5 ring-1 ring-primary/20)',
          'hover:scale-105 hover:shadow-md',
          'active:scale-95',
          currentTag === tag.name
            ? 'border-primary/50 bg-primary/5 ring-1 ring-primary/30 font-medium'
            : '',
        ]}
        style={`opacity: 0; animation: fadeInUp 0.4s cubic-bezier(0.165, 0.84, 0.44, 1) forwards; animation-delay: ${0.1 + index * 0.05}s;`}
      >
        <span class="whitespace-nowrap text-sm font-medium">{tag.name}</span>
        <span class="h-6 min-w-6 inline-flex items-center justify-center rounded-full bg-muted px-2 text-xs font-medium">
          {tag.count}
        </span>
      </a>
    ))}
  </div>

  {tags.length === 0 && (
    <div class="py-24 text-center text-secondary/60">
      <p class="text-lg">暂无标签</p>
    </div>
  )}
</div>
