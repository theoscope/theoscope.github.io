---
import { getActiveAnnouncements } from '@/data/announcement'
import { getLangFromLocale } from '@/i18n/lang'
import { ui } from '@/i18n/ui'

const currentLang = getLangFromLocale(Astro.currentLocale)
const activeAnnouncements = getActiveAnnouncements(currentLang)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

{activeAnnouncements.map((announcement, index) => {
  const modalId = `announcement-modal-${announcement.id}`
  const buttonId = `confirm-button-${announcement.id}`

  // 根据公告类型获取极简样式
  const getTypeClass = (type: string) => {
    switch (type) {
      case 'important': return 'border-b border-blue-300 dark:border-blue-700'
      case 'warning': return 'border-b border-amber-300 dark:border-amber-700'
      case 'error': return 'border-b border-red-300 dark:border-red-700'
      case 'success': return 'border-b border-green-300 dark:border-green-700'
      case 'update': return 'border-b border-purple-300 dark:border-purple-700'
      case 'info': return 'border-b border-cyan-300 dark:border-cyan-700'
      case 'notice': return 'border-b border-indigo-300 dark:border-indigo-700'
      case 'event': return 'border-b border-pink-300 dark:border-pink-700'
      case 'casual': return 'border-b border-gray-300 dark:border-gray-600'
      default: return 'border-b border-border'
    }
  }

  const typeClass = getTypeClass(announcement.type)

  return (
    <div id={modalId} class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
      <div class="border-border relative max-w-md w-full border rounded-xl bg-background p-8 shadow-lg" style="opacity: 0; transform: scale(0.95); animation: fadeInUp 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;">
        <!-- 标题和类型标签 -->
        <div class="mb-6 flex items-start justify-between">
          <h3 class="text-xl font-medium leading-tight">{announcement.title}</h3>
          <span class={`rounded-full px-3 py-1 text-xs font-medium ${
            announcement.type === 'important'
? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400'
            : announcement.type === 'warning'
? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400'
            : announcement.type === 'error'
? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'
            : announcement.type === 'success'
? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
            : announcement.type === 'update'
? 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400'
            : announcement.type === 'info'
? 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-400'
            : announcement.type === 'notice'
? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400'
            : announcement.type === 'event'
? 'bg-pink-100 text-pink-700 dark:bg-pink-900/30 dark:text-pink-400'
            : announcement.type === 'casual'
? 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-400'
            : 'bg-gray-100 text-muted-foreground dark:bg-gray-800'
          }`}
          >
            {
              announcement.type === 'info'
? (currentUI.announcementTypeInfo || '信息')
              : announcement.type === 'warning'
? (currentUI.announcementTypeWarning || '警告')
              : announcement.type === 'success'
? (currentUI.announcementTypeSuccess || '成功')
              : announcement.type === 'error'
? (currentUI.announcementTypeError || '错误')
              : announcement.type === 'notice'
? (currentUI.announcementTypeNotice || '通知')
              : announcement.type === 'update'
? (currentUI.announcementTypeUpdate || '更新')
              : announcement.type === 'event'
? (currentUI.announcementTypeEvent || '活动')
              : announcement.type === 'important'
? (currentUI.announcementTypeImportant || '重要')
              : announcement.type === 'casual'
? (currentUI.announcementTypeCasual || '休闲')
              : announcement.type
            }
          </span>
        </div>

        <!-- 内容 -->
        <div class="text-muted-foreground mb-8 leading-relaxed">
          {announcement.content}
        </div>

        <!-- 确认按钮 -->
        <div class="flex justify-end">
          <button
            id={buttonId}
            data-version={announcement.version}
            class="border-border hover:bg-muted border rounded-lg px-6 py-2.5 text-sm font-medium transition-colors"
          >
            {announcement.confirmText}
          </button>
        </div>
      </div>
    </div>
  )
})}

<script is:inline>
  // 检查是否已经确认过公告
  function checkAnnouncements() {
    const storedVersions = localStorage.getItem('announcementVersions')
    const versions = storedVersions ? JSON.parse(storedVersions) : {}

    // 获取所有活跃公告（从DOM中提取）
    const modals = document.querySelectorAll('[id^="announcement-modal-"]')
    let shownModal = false

    modals.forEach((modal) => {
      const announcementId = modal.id.replace('announcement-modal-', '')
      const button = document.getElementById(`confirm-button-${announcementId}`)
      if (button && !shownModal) {
        const version = Number.parseInt(button.dataset.version || '0')
        if (version > 0 && (!versions[announcementId] || versions[announcementId] < version)) {
          modal.classList.remove('hidden')
          modal.classList.add('flex')
          // 重置动画
          const content = modal.querySelector('div.border')
          if (content) {
            content.style.animation = 'none'
            void content.offsetWidth // 触发重排
            content.style.animation = 'fadeInUp 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) forwards'
          }
          shownModal = true // 只显示第一个未确认的公告
        }
      }
    })
  }

  // 确认公告
  function confirmAnnouncement(announcementId, version) {
    const storedVersions = localStorage.getItem('announcementVersions')
    const versions = storedVersions ? JSON.parse(storedVersions) : {}

    versions[announcementId] = version
    localStorage.setItem('announcementVersions', JSON.stringify(versions))

    const modal = document.getElementById(`announcement-modal-${announcementId}`)
    if (modal) {
      modal.classList.add('hidden')
      modal.classList.remove('flex')
    }

    // 检查并显示下一个未确认的公告
    checkAnnouncements()
  }

  // 页面加载时检查公告并绑定事件
  window.addEventListener('DOMContentLoaded', () => {
    checkAnnouncements()

    // 绑定所有确认按钮点击事件
    const confirmButtons = document.querySelectorAll('[id^="confirm-button-"]')
    confirmButtons.forEach((button) => {
      const announcementId = button.id.replace('confirm-button-', '')
      // 从按钮的data属性中获取版本号
      const version = Number.parseInt(button.dataset.version || '0')

      if (version > 0) {
        button.addEventListener('click', () => confirmAnnouncement(announcementId, version))
      }
    })
  })
</script>
